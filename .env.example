# Prisma Client / app runtime: use the Supabase pooled connection string.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma CLI / migrations: use the Supabase Session Pooler string on port 5432.
# If your local network supports IPv6 or your project has the IPv4 add-on, you can use the direct db.[PROJECT-REF].supabase.co string instead.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
ADMIN_SESSION_SECRET="replace-this-with-a-long-random-secret"
# Keep false to use the built-in rule-based chatbot.
USE_OPENAI="false"
# Only required when USE_OPENAI=true.
OPENAI_API_KEY="replace-this-with-your-openai-api-key"
OPENAI_CHAT_MODEL="gpt-5.4-mini"
